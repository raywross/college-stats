# Copy to .env.local and fill in. Never commit real keys (.env* is git-ignored).

# College Scorecard API key for `npm run sync-data`. Get one at https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# Where the app reads the dataset: "json" (data/*.json, the default) or "supabase". See specs/supabase.md.
DATA_SOURCE=json

# Supabase project (dashboard > Project Settings > API Keys / Data API). Use the DEVELOPMENT project here;
# production values live in Vercel and in .env.production.local.
SUPABASE_URL=
# sb_publishable_...: the app's read-only key (row-level security allows reads only)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...: only `npm run publish-data` uses it. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: direct Postgres login (admin), for applying supabase/migrations/ and inspecting the database from a
# terminal. The app and publish script don't use it. Dashboard > Connect > Session pooler (works over IPv4).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: seconds before the app re-reads Supabase in the background (default 600).
# DATA_TTL_SECONDS=600
