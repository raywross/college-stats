# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code worktrees, one per session (see CLAUDE.md)
/.claude/worktrees/

# Downloaded NCES files, reused between history builds (npm run sync-history)
/.cache/

# The bundled data snapshot, downloaded at build time (npm run fetch-snapshot; specs/data-platform/publish.md)
/.data/

# The college data left the repository in phase 4 of the data platform (specs/data-platform/git-ci-tests.md): it lives
# in Supabase as layers and is served as snapshots. A stray data/ folder from an old checkout or a script is never committed.
/data/

# Supabase CLI state (written by `supabase link`)
supabase/.temp/
