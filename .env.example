# Copy to .env.local and fill in. Never commit real keys (.env* is git-ignored).

# College Scorecard API key for `npm run sync-data`. Get one at https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# Claude API key for `npm run sync-college-reported` (reads colleges' own class profiles and Common Data Sets;
# specs/college-reported-data.md). Get one at https://platform.claude.com/. The app itself never uses it.
ANTHROPIC_API_KEY=

# Where the app reads the dataset: "json" (data/*.json, the default) or "supabase". See specs/supabase.md.
DATA_SOURCE=json

# Supabase project (dashboard > Project Settings > API Keys / Data API). Use the DEVELOPMENT project here;
# production values live in Vercel and in .env.prod.local (same variables, prod project; used only by
# `npm run publish-data:prod`). Not .env.production.local: Next.js would load that into local production builds.
SUPABASE_URL=
# sb_publishable_...: the app's read-only key (row-level security allows reads only)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...: only `npm run publish-data` uses it. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: direct Postgres login (admin), for applying supabase/migrations/ and inspecting the database from a
# terminal. The app and publish script don't use it. Dashboard > Connect > Session pooler (works over IPv4).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: after publishing, `npm run publish-data` POSTs to the site so static pages regenerate. Set both in
# .env.prod.local (production site) or leave unset. The same REVALIDATE_SECRET goes in Vercel (Production).
# REVALIDATE_URL=https://<your-site>/api/revalidate
# REVALIDATE_SECRET=

# Optional: transactional email through Resend (invitations, update digests; lib/email.ts). Both need a verified
# sending domain. When either is unset, nothing is emailed: invitation links are shown on screen to copy, and the
# digest job logs a dry run. Magic links don't use these: Supabase Auth sends them (specs/product/accounts.md#setup).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Quad <hello@your-domain>

# Bearer token for Vercel Cron's daily call to /api/cron/digests (specs/product/follow-colleges.md#setup-owner).
# Any long random string; set the same value in Vercel's project environment variables. Without it the cron route
# always answers 401 and no digest is ever sent.
# CRON_SECRET=
